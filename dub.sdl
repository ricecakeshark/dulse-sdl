name "kelp-sdl"
description "A minimal D application."
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

dependency "kelp-core" path="..\\kelp_core"
dependency "bindbc-sdl" version="~>2.4.0"

subConfiguration "bindbc-sdl" "static"

targetType "sourceLibrary"
targetName "kelp_sdl"
targetPath "build"
sourcePaths "source"
importPaths "source"

versions "SDL_3_4_4" "SDL_Image_3_2" "SDL_Mixer_3_2_2" "SDL_TTF_3_2_2"
libs "SDL3" "SDL3_image" "SDL3_mixer" "SDL3_ttf"

dflags "-preview=in"
