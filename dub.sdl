name "kelp-sdl"
description "A minimal D application."
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

dependency "kelp-core" path="..\\kelp_core"
dependency "bindbc-sdl" version="~>2.3.1"

subConfiguration "bindbc-sdl" "static"

targetType "library"
targetName "kelp_sdl"
targetPath "build"

versions "SDL_3_2_18" "SDL_Image_3_2" "SDL_TTF_3_2_2"
libs "SDL3" "SDL3_image"
