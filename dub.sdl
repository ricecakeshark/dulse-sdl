name "kelp-sdl"
description "A minimal D application."
authors "RiceShark"
copyright "Copyright © 2025, RiceShark"
license "proprietary"

dependency "kelp-core" path="..\\kelp_core"
dependency "bindbc-sdl" version="~>2.4.2"

subConfiguration "bindbc-sdl" "static"

targetType "sourceLibrary"
targetName "kelp_sdl"
targetPath "build"
sourcePaths "source"
importPaths "source"

//lflags "/LIBPATH:$PACKAGE_DIR\\lib\\"
lflags "/LIBPATH:$PACKAGE_DIR\\lib\\win_x86-64" platform="windows-x86_64"
copyFiles "lib\\win_x86-64\\*.dll" platform="windows-x86_64"
versions "SDL_3_4_10" "SDL_Image_3_2" "SDL_Mixer_3_2_2" "SDL_TTF_3_2_2"
libs "SDL3" "SDL3_image" "SDL3_mixer" "SDL3_ttf"

dflags "-preview=in"
